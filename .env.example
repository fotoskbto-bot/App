# ─────────────────────────────────────────────────────────────
# MACADAMIA SHOP — Variables de entorno
# Copia este archivo como .env.local y completa los valores
# ─────────────────────────────────────────────────────────────

# ID del Google Spreadsheet (lo ves en la URL de tu hoja)
# Ejemplo: https://docs.google.com/spreadsheets/d/ESTE_ES_EL_ID/edit
GOOGLE_SHEET_ID=TU_SPREADSHEET_ID_AQUI

# Credenciales de Google Service Account (JSON en una sola línea)
# Ve a: console.cloud.google.com → APIs → Credentials → Service Account
GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...@....iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}

# Contraseña simple para proteger el acceso a la app (opcional)
APP_PASSWORD=macadamia2024
